#!/bin/sh

set -e

###################
# Setting Up Vars #
###################

SRC="$(pwd)"

PROGRAMS="dmenu dwm slock slstatus st surf xmouseless"

#################################
# Cloning and Updating Programs #
#################################

clone_or_update() {
    for repo in $PROGRAMS; do
        if [ ! -d "$SRC/$repo" ]; then
            git clone "https://github.com/rafa-99/$repo.git" "$SRC/$repo"
        else
            git -C "$SRC/$repo" pull
        fi
    done
}

##########################
# Setting Configurations #
##########################

copy_configs() {
    for repo in $PROGRAMS; do
        if [ ! -f "$SRC/$repo/config.h" ]; then
            cp "$HOME/.config/suckless/$repo/config.h" "$SRC/$repo/"
        fi
    done
}

########################
# Compiling Programs   #
########################

compile() {
    for repo in $PROGRAMS; do
        make -C "$SRC/$repo" clean
        make -C "$SRC/$repo"
    done
}

########################
# Installing Programs  #
########################

install() {
    for repo in $PROGRAMS; do
        make -C "$SRC/$repo" install
    done
}

case "$1" in
    setup)
        clone_or_update
        copy_configs
        ;;

    compile)
        compile
        ;;

    install)
        install
        ;;

    all)
        clone_or_update
        copy_configs
        compile
        ;;

    *)
        echo "Usage: $0 {setup|compile|install|all}"
        exit 1
        ;;
esac